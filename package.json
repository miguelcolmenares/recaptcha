{
  "name": "recaptcha-next",
  "version": "0.1.0",
  "description": "Google reCAPTCHA v3 for React and Next.js: client token generation and server-side verification.",
  "author": "Miguel Colmenares <me@miguelcolmenares.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "node scripts/verify-package.mjs && playwright test -c e2e/playwright.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "keywords": [
    "recaptcha",
    "recaptcha-v3",
    "react",
    "nextjs",
    "server-actions",
    "captcha"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelcolmenares/recaptcha-next.git"
  },
  "bugs": {
    "url": "https://github.com/miguelcolmenares/recaptcha-next/issues"
  },
  "homepage": "https://github.com/miguelcolmenares/recaptcha-next#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "next": "^16.4.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
